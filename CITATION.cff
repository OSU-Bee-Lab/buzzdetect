date-released: "2026-10-20"  # set by scripts/sync-version.mjs (npm version)
keywords:
  - bioacoustics
  - passive acoustic monitoring
  - pollinators
  - machine learning
# this is the concepts DOI representing all versions
doi: "10.5281/zenodo.15537954"


