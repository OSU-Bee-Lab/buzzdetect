{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "buzzdetect",
  "version": "2.0.0-a2",
  "identifier": "com.luke.buzzdetect",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "buzzdetect",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/buzzdetect-engine"
    ],
    "resources": {
      "engine-payload/": "engine-payload/"
    }
  }
}
