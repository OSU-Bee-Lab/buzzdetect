{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "buzzdetect",
  "version": "2.1.0",
  "identifier": "com.luke.buzzdetect",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/check-engine-fresh.mjs && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "buzzdetect",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1OTE5MDlENjAwQzRFOUUKUldTZVRneGduWkNSdFVxUUZNWHJIVDMzWFkrSnNXNHI4c1Z6YUZHbVRWblJHYUFSMmlRU3M2c2oK",
      "endpoints": [
        "https://github.com/OSU-Bee-Lab/buzzdetect/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "engine-payload/": "engine-payload/"
    }
  }
}
