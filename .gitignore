# engine/ brings its own .gitignore files (engine/.gitignore,
# engine/models/.gitignore, engine/embedders/.gitignore), which already cover
# __pycache__, .venv, and untracked model/embedder directories. Don't
# duplicate those rules here -- but they only apply under engine/, so the
# equivalents for the repo root are listed below.

# python
__pycache__/
.venv/

